<Window x:Class="AIS.KastoMaster.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIS.KastoMaster.View.Windows"
        mc:Ignorable="d"
        Title="Окно авторизации" Height="1080" Width="1920" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="920"/>
            <ColumnDefinition Width="500"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="150"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Sourse/background.jpg" />
        </Grid.Background>
        <Border Background="White" CornerRadius="70" Opacity="0.4"
                Width="920" Height="1000"
                Grid.Column="1" Grid.Row="0" Grid.RowSpan="11" Margin="0,13,0,11"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="KASTOMASTER" 
                   FontSize="70" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <TextBox Name="LoginTb" Grid.Row="3" Grid.Column="1" Text="Имя пользователя" VerticalContentAlignment="Center" 
                 FontSize="35" Foreground="White" Background="Transparent"
                 Height="70" Width="500" MouseEnter="LoginTb_MouseEnter" MouseLeave="LoginTb_MouseLeave"/>
        <PasswordBox Name="PasswordPb" VerticalContentAlignment="Center" 
                     Foreground="White" Background="Transparent" 
                     Height="70" Width="500" Grid.Row="5" Grid.Column="1" FontSize="35"/>
        <Button Name="AuthorizationBtn" Grid.Row="8" Grid.Column="1"
                Content="Войти"  Height="70" Width="200" FontSize="45" 
                Background="#011c36" Foreground="White" Click="AuthorizationBtn_Click"/>
    </Grid>
</Window>
