<Window x:Class="AIS.KastoMaster.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIS.KastoMaster.View.Windows"
        mc:Ignorable="d"
        Title="Окно авторизации" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="370"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="325"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Sourse/background.jpg" />
        </Grid.Background>
        <Border Background="White" CornerRadius="30" Opacity="0.5"
                Width="Auto" Height="420"
                Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" />
    
        <TextBlock Text="KastoMaster"
         FontSize="27" Foreground="White"
         Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <StackPanel Grid.Row="2" Grid.Column="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="/Sourse/user.png" Width="30" />
                <TextBox Text="Введите имя пользователя" VerticalContentAlignment="Center" 
                 FontSize="15" Foreground="White" Background="Transparent"
                         Height="40" Width="190"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="30">
                <Image Source="/Sourse/lock 1.png"  Width="35"/>
                <PasswordBox VerticalContentAlignment="Center" 
     FontSize="15" Foreground="White" Background="Transparent" Height="40" Width="190"/>
            </StackPanel>
           
        </StackPanel>
        <Button Content="Войти" Grid.Row="2" Grid.Column="1" Height="30" Width="70" VerticalAlignment="Bottom" Margin="20"/>

    </Grid>
</Window>
