<Window x:Class="AIS.KastoMaster.View.Windows.ActiveOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIS.KastoMaster.View.Windows"
        mc:Ignorable="d"
        Title="ActiveOrderWindow" Height="1080" Width="1920">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="135"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="580"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <ImageBrush ImageSource="/Sourse/background.jpg" />
        </Grid.Background>
        <Border Background="White" CornerRadius="70" Opacity="0.5"
    Width="1650" Height="800" Grid.RowSpan="5" Grid.ColumnSpan="5" Margin="135,132,-465,3"/>
        <TextBlock Grid.Row="0" Text="KASTOMASTER" 
             FontSize="70" Foreground="White" VerticalAlignment="Center" 
              Grid.Column="3"  HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="1" Text="Активные заказов" 
     FontSize="50" Foreground="White" VerticalAlignment="Center" 
      Grid.Column="1" HorizontalAlignment="Right"/>
        <TextBlock Grid.Row="2" Text="Список заказов:" 
FontSize="50" Foreground="White" VerticalAlignment="Center" 
 Grid.Column="3"  HorizontalAlignment="Center"/>
        <ListView Grid.Row="3" Grid.Column="1"  
              Grid.ColumnSpan="4" Name="OrderHistoryLv" 
               BorderThickness="5" BorderBrush="Black" FontSize="40" Width="1200" Margin="51,0,-331,0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="номер заказа" Width="300" DisplayMemberBinding="{Binding}"/>
                    <GridViewColumn Header="имя клиента" Width="300" />
                    <GridViewColumn Header="статус заказа" Width="300"/>
                    <GridViewColumn Header="сумма" Width="300"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="Далее" Grid.Row="4" Grid.Column="3" FontSize="60"/>
        <Button Name="GoEnd" Content="Назад" Grid.Row="4" Grid.Column="1" FontSize="60" Click="GoEnd_Click"/>
    </Grid>
</Window>
